# detoks.gr — sunucu ortam değişkenleri (şablon; gerçek değerler repoya girmez)

# Yayın origin'leri (virgülle). Boşsa yalnız localhost kabul edilir (ödeme dönüş URL'leri bu listeye kilitlidir).
SITE_ORIGINS=https://detoks.gr,https://www.detoks.gr

# Shopify hosted checkout (kapalı karar). Üçü doluysa ödeme Shopify'a gider; boşsa geçici Stripe.
SHOPIFY_STORE_DOMAIN=detoks.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2025-07

# Geçici Stripe Checkout (Shopify açılana kadar). Boşsa ödeme "bağlı değil" durumunda kalır.
STRIPE_SECRET_KEY=

# Önizleme şeridi ve /uyum sayfasını yayında açmak için (normalde boş)
VITE_ONIZLEME=

# Canonical/hreflang/OG mutlak URL üretimi (seo.ts pageOrigin). Alan adı kesinleşince doldurulur.
VITE_SITE_ORIGIN=https://detoks.gr
