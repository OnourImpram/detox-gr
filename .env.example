# Server configuration only. Never commit real credentials.
# A connected provider never bypasses src/data/commerce-config.json approvals.
SITE_ORIGINS=https://detoks.gr,https://www.detoks.gr

# Shopify is the only new checkout path. Verify the API version at launch.
SHOPIFY_STORE_DOMAIN=detoks.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2025-07

# Optional legacy receipt lookup only. This is NOT an automatic checkout fallback.
STRIPE_SECRET_KEY=

# Internal compliance preview. Never use this flag to authorize a sale.
VITE_ONIZLEME=

# Real deployed base URL for canonical and sharing metadata. Confirm before launch.
VITE_SITE_ORIGIN=https://detoks.gr

# The original App Builder chrome is not part of v3.
